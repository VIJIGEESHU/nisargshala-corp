# Nisargshala Corporate Gift Voucher System Environment Configuration
# Target Subdomain: https://corp.nisargshala.in/

# Public App URL
NEXT_PUBLIC_SITE_URL=https://corp.nisargshala.in

# Supabase Public Configuration (Client & Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Secret Configuration (Server-Side Only - NEVER expose to browser)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Retail Integration API Secret Key (Shared secret with nisargshala.in)
VOUCHER_API_SECRET=your-secure-retail-api-secret-key-min-32-chars

# Environment
NODE_ENV=production
